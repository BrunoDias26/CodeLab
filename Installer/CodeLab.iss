; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.

#define MyAppName "CodeLab"
#define MyAppVersion "1.0.1"
#define MyAppPublisher "CodeLab"
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{1558D828-20B2-4F3A-AF2D-7DAB7707FEC5}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
AppPublisher={#MyAppPublisher}
; {app} = Revit's add-ins folder; each Revit year is a subfolder (2025, 2026), see [Files]
DefaultDirName={userappdata}\Autodesk\Revit\Addins
; Always use the folder above: version 1.0.0 installed straight into ...\Addins\2025, and reusing it
; would create ...\Addins\2025\2025
UsePreviousAppDir=no
DisableDirPage=yes
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
; Remove the following line to run in administrative install mode (install for all users).
PrivilegesRequired=lowest
; Keep the uninstaller (unins000.exe / unins000.dat) out of Revit's add-ins folder:
; it goes to C:\Users\<user>\AppData\Local\CodeLab\Uninstall
UninstallFilesDir={localappdata}\{#MyAppName}\Uninstall
; Icon of the CodeLab-x.y.z-Setup.exe file (and of its wizard window): 16 to 256 px inside one .ico
SetupIconFile=C:\DEV\CodeLab\Icons\CodeLab.ico
; Icon shown next to CodeLab in Windows Settings > Apps (the uninstaller carries the setup icon)
UninstallDisplayIcon={uninstallexe}
; Small image at the top right of every wizard page. Two sizes: Inno picks the one that best fits
; the screen scaling (64 px at 100%, 128 px on high-DPI screens)
WizardSmallImageFile=C:\DEV\CodeLab\Icons\CodeLab-64x64.png,C:\DEV\CodeLab\Icons\CodeLab-128x128.png
OutputDir=C:\DEV\CodeLab\Installer\Output
; File name built from the defines at the top: change the version only in MyAppVersion
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-Setup
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Types]
; Only one type: the user just ticks the Revit versions
Name: "custom"; Description: "Choose the Revit versions"; Flags: iscustom

[Components]
; One checkbox per Revit year (both ticked by default)
Name: "revit2025"; Description: "CodeLab for Revit 2025"; Types: custom
Name: "revit2026"; Description: "CodeLab for Revit 2026"; Types: custom

[InstallDelete]
; Before installing, remove the old add-in folder of each chosen year, so files dropped in a new version
; don't stay behind (only the CodeLab folders: other add-ins in Revit's folders are never touched)
Type: filesandordirs; Name: "{app}\2025\CodeLab"; Components: revit2025
Type: filesandordirs; Name: "{app}\2026\CodeLab"; Components: revit2026

[Files]
; Revit 2025: files of the Release.R25 build
Source: "C:\DEV\CodeLab\CodeLab\bin\Release.R25\publish\CodeLab.addin"; DestDir: "{app}\2025"; Components: revit2025; Flags: ignoreversion
Source: "C:\DEV\CodeLab\CodeLab\bin\Release.R25\publish\CodeLab\*"; DestDir: "{app}\2025\CodeLab"; Components: revit2025; Flags: ignoreversion recursesubdirs createallsubdirs
; Revit 2026: files of the Release.R26 build
Source: "C:\DEV\CodeLab\CodeLab\bin\Release.R26\publish\CodeLab.addin"; DestDir: "{app}\2026"; Components: revit2026; Flags: ignoreversion
Source: "C:\DEV\CodeLab\CodeLab\bin\Release.R26\publish\CodeLab\*"; DestDir: "{app}\2026\CodeLab"; Components: revit2026; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files.

